{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Delivery: Discover",
      "type": "process",
      "command": "node",
      "args": ["scripts/delivery-stage.mjs", "discover"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Delivery: Plan",
      "type": "process",
      "command": "node",
      "args": ["scripts/delivery-stage.mjs", "plan"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Delivery: Design",
      "type": "process",
      "command": "node",
      "args": ["scripts/delivery-stage.mjs", "design"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Delivery: Build",
      "type": "process",
      "command": "node",
      "args": ["scripts/delivery-stage.mjs", "build"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Delivery: Test",
      "type": "process",
      "command": "node",
      "args": ["scripts/delivery-stage.mjs", "test"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Delivery: Release",
      "type": "process",
      "command": "node",
      "args": ["scripts/delivery-stage.mjs", "release"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Demo: Start Application",
      "type": "process",
      "command": "node",
      "args": ["src/server.mjs"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "projectcollab-demo",
        "pattern": { "regexp": "^(.*)$", "message": 1 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting ProjectPulse",
          "endsPattern": "ProjectPulse is ready"
        }
      },
      "presentation": { "reveal": "always", "panel": "new", "clear": true }
    }
  ]
}
